@model IEnumerable<DoAnLTW.DichVu>

<!-- Services -->
<div class="container-fluid mx-auto my-5" style="max-width:1400px">
    <div class="row g-4">
        @foreach (var i in Model)
        {
            <div class="col-md-6 col-lg-3 service">
                <div class="card card-body border-0 text-center rounded-3 p-4" style="background-color:#e8f2f7">
                    <div class="rounded-circle mb-5 mx-auto p-3" style="background-color:#7ba3d1">
                        <i class="@i.Icon text-white"></i>
                    </div>
                    <h5>@i.TenDichVu</h5>
                    <p class="mb-0">@i.MoTa</p>
                </div>
            </div>
        }
    </div>
</div>