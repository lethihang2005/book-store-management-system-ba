@model DoAnLTW.Sach
@{
    ViewBag.Title = "Sửa sản phẩm";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<h2>Cập nhật sản phẩm</h2>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@using (Html.BeginForm("SuaSanPham", "SanPham", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaSach)

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })


        <div class="form-group mb-3">
            <p class="p-1 m-0">Tên sách</p>
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.TenSach, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.TenSach, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Tác giả</p>
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.TacGia, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.TacGia, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Năm xuất bản</p>
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.NamXB, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NamXB, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Số trang</p>
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.SoTrang, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.SoTrang, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Giá bán</p>
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.GiaBan, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.GiaBan, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Giá gốc</p>
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.GiaGoc, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.GiaGoc, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Số lượng tồn</p>
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.SoLuongTon, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Mô tả</p>
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.NoiDung, 5, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NoiDung, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Ảnh bìa</p>
            <div class="col-md-10">
                @if (!string.IsNullOrEmpty(Model.AnhBia))
                {
                    <img src="@Url.Content(Model.AnhBia)" alt="Ảnh bìa" style="width:120px;" class="img-thumbnail mb-2" />

                }
                <input type="file" name="AnhBia" class="form-control" />
                @Html.HiddenFor(m => m.AnhBia)
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Loại sách</p>
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.MaLoai, (SelectList)ViewBag.LoaiList, "Chọn loại", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MaLoai, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mb-3">
            <p class="p-1 m-0">Nhà xuất bản</p>
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.MaNXB, (SelectList)ViewBag.NXBList, "Chọn NXB", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MaNXB, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group mt-3">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Cập nhật sản phẩm" class="btn btn-success" />
                <a href="@Url.Action("Index", "SanPham")" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
}
