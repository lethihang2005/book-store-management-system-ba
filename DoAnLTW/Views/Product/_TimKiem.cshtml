@using (Html.BeginForm("TimKiem", "Product", FormMethod.Get))
{
    if (ViewBag.CurrentSort != null)
    {
        <input type="hidden" name="sort" value="@ViewBag.CurrentSort" />
    }

    <!-- Thể loại -->
    @Html.Action("_Categories", "Product")

    <!-- Tác giả -->
    @Html.Action("_Publishers", "Product")

    <!-- Giá -->
    @Html.Action("_Prices", "Product")

    <hr />
    <button class="btn btn-custom w-100" type="submit">Tìm sách</button>
    <a href="@Url.Action("Index", "Product")" class="btn btn-custom w-100 my-3">Xóa bộ lọc</a>
}