@model DoAnLTW.HoaDon
@{
    ViewBag.Title = "Cập nhật trạng thái";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<h2>Cập nhật trạng thái đơn hàng</h2>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@using (Html.BeginForm("CapNhatTrangThai", "DonHang", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.MaHD)

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.MaKH, "Mã khách hàng", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.NguoiDung.HoTen, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.NguoiDung.HoTen, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.MaKM, "Mã khuyến mãi", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.KhuyenMai.TenKM, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.KhuyenMai.TenKM, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.NgayLap, "Ngày lập", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.NgayLap, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.NgayLap, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.TongTien, "Tổng tiền", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.TongTien, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.TongTien, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.GiamGia, "Giảm giá", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.GiamGia, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.GiamGia, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.PhiVanChuyen, "Phí vận chuyển", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.PhiVanChuyen, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.PhiVanChuyen, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.ThanhTien, "Thành tiền", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.ThanhTien, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.ThanhTien, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.DiaChiGiaoHang, "Đại chỉ giao hàng", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.DiaChiGiaoHang, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.DiaChiGiaoHang, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.GhiChu, "Ghi chú", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.GhiChu, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.GhiChu, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.TinhTrang, "Tình trạng", new { @class = "control-label" })
            @Html.DropDownListFor(model => model.TinhTrang, (SelectList)ViewBag.TTList, "Chọn tình trạng", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.TinhTrang, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.MaPTTT, "Phương thức thanh toán", new { @class = "control-label" })
            @Html.DropDownListFor(model => model.PhuongThucThanhToan.TenPTTT, (SelectList)ViewBag.PTTTList, "Chọn phương thức thanh toán", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.PhuongThucThanhToan.TenPTTT, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.DaThanhToan, "Tình trạng thanh toán", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.DaThanhToan, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.DaThanhToan, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Cập nhật" class="btn btn-primary mt-3" />
            </div>
        </div>
    </div>
}
<div>
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary mt-3" })
</div>