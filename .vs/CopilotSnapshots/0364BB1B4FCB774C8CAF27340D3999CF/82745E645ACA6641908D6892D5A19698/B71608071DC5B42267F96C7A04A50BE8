@using System.Globalization
@{
    ViewBag.Title = "Thống kê doanh thu";
    Layout = "~/Views/Shared/_Layout2.cshtml";
    string loaiThongKe = (ViewBag.LoaiThongKe != null) ? (string)ViewBag.LoaiThongKe : "thang";
    var thongKe = ViewBag.ThongKe as List<object[]>;
}

<h3>Thống kê doanh thu (@loaiThongKe)</h3>

<form method="get" class="mb-3">
    <label>Chọn loại thống kê:</label>
    <select name="loaiThongKe" onchange="this.form.submit()" class="form-select w-auto d-inline">
        <option value="ngay" @(loaiThongKe == "ngay" ? "selected" : "")>Theo ngày</option>
        <option value="thang" @(loaiThongKe == "thang" ? "selected" : "")>Theo tháng</option>
        <option value="nam" @(loaiThongKe == "nam" ? "selected" : "")>Theo năm</option>
    </select>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-success">
        <tr>
            @if (loaiThongKe == "ngay")
            {
                <th>Ngày</th>
 }
            else if (loaiThongKe == "thang")
            {
                <th>Tháng</th>
                <th>Năm</th>
 }
            else if (loaiThongKe == "nam")
            {
                <th>Năm</th>
}
            <th>Doanh thu</th>
        </tr>
    </thead>
    <tbody>
        @if (thongKe != null && thongKe.Count > 0)
        {
            foreach (var dt in thongKe)
            {
                <tr>
                    @if (loaiThongKe == "ngay")
                    {
                        <td>
                            @{
                                var dateValue = (DateTime?)dt[0];
                                @(dateValue.HasValue ? dateValue.Value.ToString("dd/MM/yyyy") : "")
                            }
                        </td>
                    }
                    else if (loaiThongKe == "thang")
                    {
                        <td>@dt[0]</td>
                        <td>@dt[1]</td>
                    }
                    else if (loaiThongKe == "nam")
                    {
                        <td>@dt[0]</td>
                    }
                    <td>@Convert.ToDecimal(dt[loaiThongKe == "thang" ? 2 : 1]).ToString("N0", new CultureInfo("en-US")) đ</td>

                </tr>
            }
        }
        else
        {
            <tr><td colspan="3" class="text-center">Chưa có dữ liệu</td></tr>
        }
    </tbody>
</table>
