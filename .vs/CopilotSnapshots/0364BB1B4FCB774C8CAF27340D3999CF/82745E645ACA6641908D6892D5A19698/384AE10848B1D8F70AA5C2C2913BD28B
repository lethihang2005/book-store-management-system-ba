@{
    ViewBag.Title = "Quản lý Loại Sách";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<h3>Quản lý Loại Sách</h3>

<div class="mb-3">
    <button class="btn btn-primary" id="btnThemLoai">+ Thêm Loại</button>
</div>

<div id="alertMessage" class="alert d-none" role="alert"></div>

<table class="table table-bordered table-striped" id="tblLoaiSach">
    <thead class="table-primary">
        <tr>
            <th class="text-center">STT</th>
            <th class="text-center">Ảnh đại diện</th>
            <th>Tên loại</th>
            <th>Ghi chú</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div class="modal fade" id="modalLoaiSach" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm Loại Sách</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formLoaiSach">
                    <input type="hidden" id="MaLoai" />
                    <input type="hidden" id="AnhDaiDien" />

                    <div class="mb-3">
                        <label>Tên loại <span class="text-danger">*</span></label>
                        <input type="text" id="TenLoai" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Ghi chú</label>
                        <textarea id="GhiChu" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>Ảnh đại diện</label>
                        <input type="file" id="fileUpload" class="form-control" accept="image/*" />
                        <small class="text-muted">Chấp nhận: JPG, PNG, GIF (Max 5MB)</small>

                        <!-- Preview ảnh -->
                        <div id="imagePreview" class="mt-2 d-none">
                            <img id="previewImg" src="" class="img-thumbnail" style="max-width: 200px; max-height: 200px;" />
                            <button type="button" class="btn btn-sm btn-danger ms-2" id="btnRemoveImage">
                                <i class="fas fa-times"></i> Xóa ảnh
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success" id="btnLuu">
                        <span id="btnLuuText">Lưu</span>
                        <span id="btnLuuSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            var modal = new bootstrap.Modal(document.getElementById('modalLoaiSach'));
            var uploadedFileName = "";

            function showToast(message, type = "success", duration = 3000) {
                const toast = document.createElement("div");
                toast.classList.add("toast-message");

                switch (type) {
                    case "success":
                        toast.classList.add("toast-success");
                        break;
                    case "danger":
                    case "error":
                        toast.classList.add("toast-error");
                        break;
                    case "warning":
                        toast.classList.add("toast-warning");
                        break;
                }

                toast.innerText = message;
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.style.transition = "0.5s";
                toast.style.opacity = "0";
                toast.style.transform = "translateY(-10px)";

                setTimeout(() => toast.remove(), 500);
            }, duration);
            }

            function loadLoaiSach() {
                $.get('/api/LoaiSach', function (data) {
                    var html = "";
                    $.each(data, function (i, loai) {
                        html += "<tr>";
                        html += "<td  class='align-middle text-center'>" + (i + 1) + "</td>";

                        if (loai.AnhDaiDien) {
                            html += "<td class='align-middle text-center'><img src='/Content/Images/" + loai.AnhDaiDien + "' style='width:60px;height:75px;object-fit:cover;' /></td>";
                        } else {
                            html += "<td class='align-middle text-center'><span class='text-muted'>Chưa có</span></td>";
                        }

                        html += "<td class='align-middle'>" + loai.TenLoai + "</td>";
                        html += "<td class='align-middle'>" + (loai.GhiChu || "") + "</td>";
                        html += "<td class='align-middle text-center'>";
                        html += "<button class='btn btn-sm btn-warning mb-1 btnSua' data-id='" + loai.MaLoai + "'>Sửa</button> ";
                        html += "<button class='btn btn-sm btn-danger mb-1 btnXoa' data-id='" + loai.MaLoai + "'>Xóa</button>";
                        html += "</td></tr>";
                    });
                    $("#tblLoaiSach tbody").html(html);
                }).fail(function (xhr) {
                    console.log("Lỗi tải dữ liệu:", xhr.responseText);
                    showToast("Không thể tải dữ liệu!", "error");
                });
            }

            loadLoaiSach();

            $("#btnThemLoai").click(function () {
                $("#modalTitle").text("Thêm Loại Sách");
                $("#MaLoai").val("");
                $("#TenLoai").val("");
                $("#GhiChu").val("");
                $("#AnhDaiDien").val("");
                $("#fileUpload").val("");
                $("#imagePreview").addClass("d-none");
                uploadedFileName = "";
                modal.show();
            });

            // Xử lý khi chọn file
            $("#fileUpload").change(function (e) {
                var file = e.target.files[0];
                if (!file) return;

                // Validate
                var allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/bmp'];
                if (!allowedTypes.includes(file.type)) {
                    showToast("Chỉ chấp nhận file ảnh!", "warning");
                    $(this).val("");
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    showToast("File không được vượt quá 5MB!", "warning");
                    $(this).val("");
                    return;
                }

                // Preview ảnh
                var reader = new FileReader();
                reader.onload = function (e) {
                    $("#previewImg").attr("src", e.target.result);
                    $("#imagePreview").removeClass("d-none");
                };
                reader.readAsDataURL(file);

                uploadImage(file);
            });

            // Upload ảnh lên server
            function uploadImage(file) {
                var formData = new FormData();
                formData.append("file", file);

                $("#btnLuu").prop("disabled", true);
                $("#btnLuuText").text("Đang upload...");

                $.ajax({
                    url: '/api/LoaiSach/UploadImage',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            uploadedFileName = response.data.fileName;
                            $("#AnhDaiDien").val(response.data.fileName);
                            showToast("Upload ảnh thành công!", "success");
                        }
                    },
                    error: function (xhr) {
                        showToast("Lỗi upload ảnh!", "error");
                        $("#fileUpload").val("");
                        $("#imagePreview").addClass("d-none");
                    },
                    complete: function () {
                        $("#btnLuu").prop("disabled", false);
                        $("#btnLuuText").text("Lưu");
                    }
                });
            }

            // Xóa ảnh đã chọn
            $("#btnRemoveImage").click(function () {
                $("#fileUpload").val("");
                $("#imagePreview").addClass("d-none");
                $("#AnhDaiDien").val("");
                uploadedFileName = "";
            });

            $("#formLoaiSach").submit(function (e) {
                e.preventDefault();

                var loai = {
                    TenLoai: $("#TenLoai").val().trim(),
                    GhiChu: $("#GhiChu").val().trim(),
                    AnhDaiDien: $("#AnhDaiDien").val().trim()
                };

                if (!loai.TenLoai) {
                    showToast("Vui lòng nhập tên loại!", "warning");
                    return;
                }

                var maLoai = $("#MaLoai").val();

                $("#btnLuu").prop("disabled", true);
                $("#btnLuuText").addClass("d-none");
                $("#btnLuuSpinner").removeClass("d-none");

                if (maLoai) {
                    // Sửa
                    $.ajax({
                        url: '/api/LoaiSach/' + maLoai,
                        type: "PUT",
                        contentType: "application/json",
                        data: JSON.stringify(loai),
                        success: function (response) {
                            loadLoaiSach();
                            modal.hide();
                            showToast(response.message || "Cập nhật thành công!", "success");
                        },
                        error: function (xhr) {
                            var errorMsg = "Có lỗi xảy ra!";
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errorMsg = xhr.responseJSON.message;
                            }
                            showToast(errorMsg, "error");
                        },
                        complete: function () {
                            $("#btnLuu").prop("disabled", false);
                            $("#btnLuuText").removeClass("d-none");
                            $("#btnLuuSpinner").addClass("d-none");
                        }
                    });
                } else {
                    // Thêm mới
                    $.ajax({
                        url: '/api/LoaiSach',
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(loai),
                        success: function (response) {
                            loadLoaiSach();
                            modal.hide();
                            showToast(response.message || "Thêm thành công!", "success");
                        },
                        error: function (xhr) {
                            var errorMsg = "Có lỗi xảy ra!";
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errorMsg = xhr.responseJSON.message;
                            }
                            showToast(errorMsg, "error");
                        },
                        complete: function () {
                            $("#btnLuu").prop("disabled", false);
                            $("#btnLuuText").removeClass("d-none");
                            $("#btnLuuSpinner").addClass("d-none");
                        }
                    });
                }
            });

            $(document).on("click", ".btnSua", function () {
                var id = $(this).data("id");
                $.get('/api/LoaiSach/' + id, function (loai) {
                    $("#modalTitle").text("Sửa Loại Sách");
                    $("#MaLoai").val(loai.MaLoai);
                    $("#TenLoai").val(loai.TenLoai);
                    $("#GhiChu").val(loai.GhiChu || "");
                    $("#AnhDaiDien").val(loai.AnhDaiDien || "");

                    // Hiển thị ảnh hiện tại nếu có
                    if (loai.AnhDaiDien) {
                        $("#previewImg").attr("src", "/Content/Images/" + loai.AnhDaiDien);
                        $("#imagePreview").removeClass("d-none");
                        uploadedFileName = loai.AnhDaiDien;
                    } else {
                        $("#imagePreview").addClass("d-none");
                    }

                    modal.show();
                }).fail(function () {
                    showToast("Không tìm thấy loại sách!", "error");
                });
            });

            $(document).on("click", ".btnXoa", function () {
                if (!confirm("Bạn có chắc muốn xóa?")) return;

                var id = $(this).data("id");
                $.ajax({
                    url: '/api/LoaiSach/' + id,
                    type: "DELETE",
                    success: function (response) {
                        loadLoaiSach();
                        showToast(response.message || "Xóa thành công!", "success");
                    },
                    error: function (xhr) {
                        var errorMsg = "Có lỗi xảy ra!";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        showToast(errorMsg, "error");
                    }
                });
            });
        });
    </script>
}