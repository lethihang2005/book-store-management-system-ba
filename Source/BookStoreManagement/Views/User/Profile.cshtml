@model DoAnLTW.NguoiDung
@{
    ViewBag.Title = "Thông tin cá nhân";
}
<div class="container my-5" style="max-width: 1200px;">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                        {
                            <img src="@Url.Content("~/Content/Images/" + Model.AnhDaiDien)" class="rounded-circle" alt="Avatar"
                                 style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #7BA3D1;">
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto"
                                 style="width: 120px; height: 120px; font-size: 48px; border: 3px solid #7BA3D1;">
                                @Model.HoTen.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </div>

                    <h5 class="mb-1">@Model.HoTen</h5>
                    <p class="text-muted mb-3">@Model.Email</p>

                    <div class="list-group list-group-flush">
                        <a href="#info" class="list-group-item list-group-item-action active" data-bs-toggle="pill">
                            <i class="fas fa-user me-2"></i> Thông tin cá nhân
                        </a>

                        <a href="#password" class="list-group-item list-group-item-action" data-bs-toggle="pill">
                            <i class="fas fa-key me-2"></i> Đổi mật khẩu
                        </a>

                        <a href="@Url.Action("Index", "Cart")" class="list-group-item list-group-item-action">
                            <i class="fas fa-shopping-cart me-2"></i> Giỏ hàng
                        </a>

                        <a href="@Url.Action("Index", "Favourite")" class="list-group-item list-group-item-action">
                            <i class="fas fa-heart me-2"></i> Yêu thích
                        </a>

                        <a href="@Url.Action("Logout", "User")" class="list-group-item list-group-item-action text-danger">
                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="tab-content">
                <!-- Tab Thông tin cá nhân -->
                <div class="tab-pane fade show active" id="info">
                    <div class="card shadow-sm">
                        <div class="card-header text-white">
                            <h5 class="mb-0 py-2">
                                <i class="fas fa-user me-2"></i> Thông tin cá nhân
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (ViewBag.Success != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="fas fa-check-circle me-2"></i> @ViewBag.Success
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }
                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @using (Html.BeginForm("UpdateProfile", "User", FormMethod.Post, new { enctype = "multipart/form-data", id = "updateProfileForm" }))
                            {
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-user me-2"></i> Họ tên <span class="text-danger">*</span>
                                        </label>
                                        @Html.TextBoxFor(model => model.HoTen, new { @class = "form-control", required = "required" })
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-envelope me-2"></i> Email
                                        </label>
                                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @readonly = "readonly", style = "background-color: #e9ecef;" })
                                        <small class="text-muted">Email không thể thay đổi</small>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-venus-mars me-2"></i> Giới tính
                                        </label>
                                        @Html.DropDownListFor(m => m.GioiTinh, new SelectList(new[] {
                                            new { Value = "Nam", Text = "Nam" },
                                            new { Value = "Nữ", Text = "Nữ" }
                                        }, "Value", "Text", Model.GioiTinh), "-- Chọn giới tính --", new { @class = "form-select" })
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-calendar me-2"></i> Năm sinh
                                        </label>
                                        @Html.TextBoxFor(m => m.NamSinh, new { @class = "form-control", type = "number", min = "1900", max = DateTime.Now.Year })
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-phone me-2"></i> Số điện thoại
                                        </label>
                                        @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", type = "tel" })
                                    </div>


                                    <input type="hidden" id="adminErrorStatus" value="@(ViewBag.AdminError != null && (bool)ViewBag.AdminError ? "true" : "false")" />

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-shield-halved me-2"></i> Quyền truy cập
                                        </label>
                                        @Html.DropDownListFor(m => m.IDVaiTro, (SelectList)ViewBag.VaiTroList, "-- Chọn quyền --", new { @class = "form-select", id = "quyenTruyCap" })
                                        @Html.ValidationMessageFor(m => m.IDVaiTro, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-6 mb-3" id="adminPasswordGroup" style="display: none;">
                                        <label for="adminPassword" class="form-label fw-bold">
                                            <i class="fas fa-lock me-2"></i> Mật khẩu Admin
                                        </label>
                                        <input type="password" id="adminPassword" name="adminPassword" class="form-control" />

                                        @if (ViewBag.AdminError != null && (bool)ViewBag.AdminError)
                                        {
                                            <div class="text-danger mt-1">@ViewBag.Error</div>
                                        }
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-map-marker-alt me-2"></i> Địa chỉ
                                        </label>
                                        @Html.TextAreaFor(m => m.DiaChi, new { @class = "form-control", rows = 3 })
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-image me-2"></i> Ảnh đại diện
                                        </label>
                                        <input type="file" name="avatarFile" class="form-control" accept="image/*" onchange="previewImage(this)">
                                        <small class="text-muted">Chọn ảnh mới nếu muốn thay đổi</small>

                                        <!-- Preview ảnh -->
                                        <div class="mt-3" id="imagePreview" style="display: none;">
                                            <img id="preview" src="" style="max-width: 200px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <button type="submit" class="btn btn-custom">
                                            <i class="fas fa-save me-2"></i> Cập nhật thông tin
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Tab Đổi mật khẩu -->
                <div class="tab-pane fade" id="password">
                    <div class="card shadow-sm">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="fas fa-key me-2"></i> Đổi mật khẩu
                            </h5>
                        </div>
                        <div class="card-body">
                            @using (Html.BeginForm("ChangePassword", "User", FormMethod.Post))
                            {
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-lock me-2"></i> Mật khẩu cũ <span class="text-danger">*</span>
                                    </label>
                                    <input type="password" name="oldPassword" class="form-control" required>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-lock me-2"></i> Mật khẩu mới <span class="text-danger">*</span>
                                    </label>
                                    <input type="password" name="newPassword" id="newPassword" class="form-control" required minlength="6">
                                    <small class="text-muted">Tối thiểu 6 ký tự</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-lock me-2"></i> Xác nhận mật khẩu <span class="text-danger">*</span>
                                    </label>
                                    <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" required minlength="6">
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="btn btn-custom">
                                        <i class="fas fa-key me-2"></i> Đổi mật khẩu
                                    </button>
                                </div>
                            </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-header, .list-group-item-action.active {
        background-color: #7ba3d1 !important;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        const $quyenTruyCap = $('#quyenTruyCap');
        const $adminPasswordGroup = $('#adminPasswordGroup');
        const $adminPassword = $('#adminPassword');

        const hasAdminError = $('#adminErrorStatus').val() === 'true';

        function handleRoleChange() {
            const selectedID = parseInt($quyenTruyCap.val());

            const isTargetingAdmin = selectedID === 1;

            if (isTargetingAdmin || hasAdminError) {
                $adminPasswordGroup.show();
                $adminPassword.attr('required', 'required');
            } else {
                $adminPasswordGroup.hide();
                $adminPassword.removeAttr('required');
                $adminPassword.val('');
            }
        }

        handleRoleChange();
        $quyenTruyCap.on('change', handleRoleChange);

    });
</script>