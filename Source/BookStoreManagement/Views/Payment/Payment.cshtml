@model DoAnLTW.HoaDon
@{
    
    ViewBag.Title = "Thanh toán";
}

<div style="max-width:600px;margin:auto;text-align:center;padding:30px">
    <h2>✅ Đặt hàng thành công!</h2>
    <p>Mã đơn hàng của bạn: <b>@Model.MaHD</b></p>

    <div style="text-align: left; border-top: 1px solid #eee; padding-top: 15px; margin-top: 15px">
        <p>Tổng tiền hàng: <b style="float: right">@(((decimal)Model.TongTien + (decimal)ViewBag.GiamGia).ToString("N0")) VNĐ</b></p>

        <p style="color: red">Giảm giá: <b style="float: right">- @(((decimal)ViewBag.GiamGia).ToString("N0")) VNĐ</b></p>

        <p>Phí vận chuyển: <b style="float: right">@(((decimal)ViewBag.PhiVanChuyen).ToString("N0")) VNĐ</b></p>

        <hr style="clear: both; margin: 10px 0">

        <p style="font-size: 1.2em">TỔNG THANH TOÁN: <b style="float: right; color: #d9534f">@(((decimal)ViewBag.TongThanhToanCuoi).ToString("N0")) VNĐ</b></p>
        <div style="clear: both"></div>
    </div>
    <p style="margin-top: 20px">Cảm ơn bạn đã mua hàng!</p>

    <a href="@Url.Action("Index","Home")" class="btn btn-custom">Quay lại trang chủ</a>
</div>