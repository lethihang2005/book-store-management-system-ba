@model List<DoAnLTW.KhuyenMai>
@{
    ViewBag.Title = "Khuyến mãi";
}
<div class="container-fluid mt-4" style="max-width:1400px">
    <h3 class="fw-bold mb-3"
        style="background: #F5F9FF; color: #0056b3; padding: 10px 20px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
        🎫 Danh sách khuyến mãi
    </h3>

    <div class="row">
        @foreach (var km in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title" style="color: #0257b4">@km.TenKM</h5>
                        <p class="card-text text-muted">@km.MoTa</p>

                        <ul class="list-unstyled mb-3">
                            <li><strong>Đơn tối thiểu:</strong> @String.Format("{0:N0} đ", km.DonToiThieu)</li>
                            <li>
                                <strong>Thời gian:</strong>
                                @km.NgayBatDau.Value.ToString("dd/MM/yyyy") - @km.NgayKetThuc.Value.ToString("dd/MM/yyyy")
                            </li>
                        </ul>

                        <span class="badge" style="background-color: #FFD700; color:#333333">Còn hiệu lực</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
