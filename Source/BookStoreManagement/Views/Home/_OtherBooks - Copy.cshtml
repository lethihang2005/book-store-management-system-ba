@model List<DoAnLTW.Sach>
@using System.Globalization
<!-- Other Books -->
<div class="container-fluid mx-auto mb-5 px-0" style="max-width: 1400px; color: #2c3e50">
    <!-- Tiêu đề và nút xem tất cả -->
    <div class="d-flex justify-content-between align-items-center mb-1 px-3">
        <h2 class="fw-bold m-0">Sách khác</h2>
        <a href="@Url.Action("Index", "Product")" class="btn btn-custom rounded-3">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <!-- Các sách bán chạy -->
    <div class="category-container categoryCarousel">
        <div class="category-wrapper categoryWrapper">
            @foreach (var i in Model)
            {
                <div class="category-col">
                    <div class="card border-0 category-item">
                        <a href="@Url.Action("Detail", "Product", new { id = i.MaSach })" class="text-center">
                            <img src="@Url.Content("~/Content/Images/"+i.AnhBia)" class="img-fluid mx-auto rounded-3 w-75" style="height:200px;object-fit:cover" alt="@i.TenSach">
                        </a>
                        <div class="card-body px-4 py-1">
                            <div class="d-flex justify-content-around gap-3">
                                <div class="text-start flex-grow-1 overflow-hidden">
                                    <p class="card-text title mb-1 text-danger">@i.TacGia</p>
                                    <h5 class="card-title title my-2">@i.TenSach</h5>
                                    <span class="card-text fw-bold text-danger">@i.GiaBan.Value.ToString("N0", new CultureInfo("en-US")) đ</span><br />
                                    <span class="card-text text-secondary text-decoration-line-through">@i.GiaGoc.Value.ToString("N0", new CultureInfo("en-US")) đ</span>
                                </div>
                                <div class="d-flex flex-column gap-2 flex-shrink-0 my-1">
                                    <a href="@Url.Action("AddToFavourite", "Favourite", new { id = i.MaSach })" class="btn btn-icon btn-sm rounded-circle p-2">
                                        <i class="fas fa-heart"></i>
                                    </a>
                                    <a href="@Url.Action("AddToCart", "Cart", new { id = i.MaSach })" class="btn btn-icon btn-sm rounded-circle p-2">
                                        <i class="fas fa-shopping-cart"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Navigation Buttons -->
        <button class="carousel-nav-btn prev btnPrev">
            <span class="carousel-nav-icon">
                <i class="fas fa-chevron-left text-white"></i>
            </span>
        </button>
        <button class="carousel-nav-btn next btnNext">
            <span class="carousel-nav-icon">
                <i class="fas fa-chevron-right text-white"></i>
            </span>
        </button>
    </div>
</div>