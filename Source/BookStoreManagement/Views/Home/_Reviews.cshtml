@model IEnumerable<DoAnLTW.DanhGia>

<!-- Reviews -->
<div class="container-fluid mx-auto px-0" style="max-width:1200px">
    <!-- Tiêu đề -->
    <h2 class="fw-bold mb-4 text-center" style="color:#2c3e50">Khách hàng nói gì</h2>

    <!-- Các đánh giá -->
    <div class="category-container categoryCarousel" data-type="review">
        <div class="category-wrapper categoryWrapper">
            @foreach (var i in Model)
            {
                <div class="review-col">
                    <div class="card card-body shadow-sm border-0 bg-primary-subtle rounded-3 p-4">
                        <p>@i.BinhLuan - <span class="fw-bold">"@i.Sach.TenSach"</span></p>
                        <hr />
                        <div class="row">
                            <div class="col-3">
                                <img src="@Url.Content("~/Content/Images/"+i.NguoiDung.AnhDaiDien)" class="mx-auto rounded-4" style="height:100px;width:100px ;object-fit:cover" alt="...">
                            </div>
                            <div class="col-9">
                                <h5 class="fw-bold">@i.NguoiDung.HoTen</h5>
                                <p>@i.NgayDanhGia.Value.ToString("dd/MM/yyyy")</p>
                                <p>
                                    @if (i.SoSao.HasValue)
                                    {
                                        for (int j = 0; j < i.SoSao.Value; j++)
                                        {
                                            <i class="fas fa-star text-warning"></i>
                                        }
                                        for (int j = i.SoSao.Value; j < 5; j++)
                                        {
                                            <i class="far fa-star text-secondary"></i>
                                        }
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Navigation Buttons -->
        <button class="carousel-nav-btn prev btnPrev">
            <span class="carousel-nav-icon">
                <i class="fas fa-chevron-left text-white"></i>
            </span>
        </button>
        <button class="carousel-nav-btn next btnNext">
            <span class="carousel-nav-icon">
                <i class="fas fa-chevron-right text-white"></i>
            </span>
        </button>
    </div>
</div>