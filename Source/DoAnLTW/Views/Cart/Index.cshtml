@model List<DoAnLTW.GioHang>
@using System.Globalization
@{
    ViewBag.Title = "Giỏ hàng";
}

<!-- Main Layout -->
<div class="container-fluid my-4" style="max-width:1400px">
    <h2 class="mb-4">
        <i class="fas fa-shopping-cart"></i>
        Giỏ hàng
    </h2>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr class="table" style="background-color: #7ba3d1">
                                    <th scope="col" style="color:#2c3e50; width:43%">Sản phẩm</th>
                                    <th scope="col" class="text-center" style="color: #2c3e50; width: 12%">Giá (đ)</th>
                                    <th scope="col" class="text-center" style="color: #2c3e50; width: 20%">Số lượng</th>
                                    <th scope="col" class="text-center" style="color: #2c3e50; width: 15%">Tổng cộng (đ)</th>
                                    <th scope="col" class="text-center" style="color: #2c3e50; width: 10%">Xóa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model)
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("Detail", "Product", new { id = i.MaSach })" class="text-decoration-none">
                                                <div class="d-flex align-items-center">
                                                    <img src="@Url.Content("~/Content/Images/" + i.Sach.AnhBia)" class="me-3" alt="@i.Sach.TenSach" width="50">
                                                    <span class="fw-bold" style="color:#2c3e50">@i.Sach.TenSach</span>
                                                </div>
                                            </a>
                                        </td>
                                        <td class="text-center" style="color:#2c3e50">@i.Sach.GiaBan.Value.ToString("N0", new CultureInfo("en-US")) đ</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("UpdateSL", "Cart", new { id = i.Sach.MaSach, type = -1 })" class="btn btn-sm btn-outline-danger"
                                               style="padding: 5px 15px; margin: 5px;">-</a>
                                            <b style="color:#2c3e50">@i.SoLuong</b>
                                            <a href="@Url.Action("UpdateSL", "Cart", new { id = i.Sach.MaSach, type = 1 })" class="btn btn-sm btn-outline-success"
                                               style="padding: 5px 15px; margin: 5px;">+</a>
                                        </td>
                                        <td class="text-center fw-bold" style="color:#2c3e50">@(((decimal)(i.Sach.GiaBan.Value * i.SoLuong)).ToString("N0", new CultureInfo("en-US")))</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = i.Sach.MaSach })" class="btn btn-sm btn-outline-danger">Xóa</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <a href="@Url.Action("Index", "Product")" class="btn btn-custom">
                                <i class="fa-solid fa-arrow-left"></i>
                                Tiếp tục xem sách
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header text-white fw-bold" style="background-color: #7ba3d1">
                        Tóm tắt đơn hàng
                    </div>
                    <div class="card-body">
                        @{
                            decimal tongThanhTien = Model.Sum(i => (decimal)(i.Sach.GiaBan.Value * i.SoLuong));
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span style="color:#2c3e50">Tổng tiền hàng:</span>
                            <span class="fw-bold" style="color:#2c3e50">@tongThanhTien.ToString("N0", new CultureInfo("en-US")) đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span style="color:#2c3e50">Phí vận chuyển:</span>
                            <span class="fw-bold" style="color:#2c3e50">30,000 đ</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3 text-danger fs-5">
                            <span class="fw-bold">TỔNG CỘNG:</span>
                            <span class="fw-bold">@((tongThanhTien + 30000).ToString("N0", new CultureInfo("en-US"))) đ</span>
                        </div>
                        <a href="@Url.Action("XNThanhToan", "Payment")" class="btn btn-custom w-100">Tiến hành Thanh toán</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <h4 class="alert-heading">Giỏ hàng trống! 😥</h4>
            <p>Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
            <hr>
            <a href="@Url.Action("Index", "Product")" class="btn btn-custom">
                <i class="fa-solid fa-arrow-left"></i>
                Bắt đầu khám phá sách ngay
            </a>
        </div>
    }

</div>