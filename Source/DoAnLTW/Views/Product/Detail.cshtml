@model DoAnLTW.Sach
@using System.Globalization
@{
    ViewBag.Title = "Thông tin sách";
    bool isFavourite = ViewBag.IsFavourite ?? false;
    string actionName = isFavourite ? "RemoveFromFavourite" : "AddToFavourite";
    string buttonText = isFavourite ? "Bỏ yêu thích" : "Thêm yêu thích";
    string iconClass = isFavourite ? "fas fa-heart-crack" : "fas fa-heart";
    string buttonClass = isFavourite ? "btn-success" : "btn-custom";

    bool isInCart = ViewBag.IsInCart ?? false;
    string actionNameCart = isInCart ? "Index" : "AddToCart";
    string buttonTextCart = isInCart ? "Đã có trong giỏ hàng" : "Thêm vào giỏ hàng";
    string iconClassCart = isInCart ? "fas fa-check-circle" : "fas fa-cart-plus";
    string buttonClassCart = isInCart ? "btn-success" : "btn-custom";

    bool hasPurchased = ViewBag.HasPurchased ?? false;
    bool hasReviewed = ViewBag.HasReviewed ?? false;

    object routeValues = isInCart ? (object)null : new { id = Model.MaSach };
}

<!-- Detail -->
<div class="container-fluid mx-auto mt-3" style="max-width:1400px">
    <!-- Tổng thể -->
    <div class="row">
        <!-- Hình -->
        <div class="col-12 col-sm-4 col-lg-3">
            <div class="product-gallery">
                <div class="main-image-container">
                    <img id="mainImage" src="@Url.Content("~/Content/Images/"+Model.AnhBia)" class="img-fluid mx-auto w-100 rounded-4" alt="@Model.TenSach">
                </div>
                <div class="thumbnails mt-3">
                    <img class="img-thumbnail" src="@Url.Content("~/Content/Images/" + Model.AnhBia)" data-full-src="@Url.Content("~/Content/Images/" + Model.AnhBia)" alt="Ảnh 1" style="width: 80px;height:80px; cursor: pointer;">
                    @foreach (var i in Model.HinhAnhs)
                    {
                        <img class="img-thumbnail" src="@Url.Content("~/Content/Images/"+i.HinhAnh1)" data-full-src="@Url.Content("~/Content/Images/"+i.HinhAnh1)" alt="Ảnh 1" style="width: 80px; height: 80px; cursor: pointer;">
                    }
                </div>
            </div>
        </div>

        <!-- Thông tin -->
        <div class="col-12 col-sm-4 col-lg-6">
            <div>
                <h3 class="fw-bold mb-3">@Model.TenSach</h3>
                <p class="my-0">Thể loại: @Model.LoaiSach.TenLoai</p>
                <p class="my-3">@Model.NXB.TenNXB</p>
                <p class="my-0">Năm xuất bản: @Model.NamXB</p>
            </div>

            <!-- Nội dung -->
            <div class="border-2 rounded-3 p-3 mt-4" style="border: dashed;text-align:justify">
                @Model.NoiDung
            </div>
        </div>

        <!-- Giá -->
        <div class="col-12 col-sm-4 col-lg-3">
            <h4 class="fw-bold text-danger">
                @Model.GiaBan.Value.ToString("N0", new CultureInfo("en-US"))đ
                <span class="text-decoration-line-through text-secondary fs-6">@Model.GiaGoc.Value.ToString("N0", new CultureInfo("en-US"))đ</span>
            </h4>
            <a href="@Url.Action("XNThanhToan", "Payment")" class="btn btn-custom w-100 mb-3">
                <i class="fas fa-bag-shopping"></i>
                Mua ngay
            </a>

            <a href="@Url.Action(actionNameCart, "Cart", routeValues)" class="btn w-100 mb-3 @buttonClassCart" style="padding: 12px 28px">
                <i class="@iconClassCart me-2"></i>
                @buttonTextCart
            </a>

            <a href="@Url.Action(actionName, "Favourite", new { id = Model.MaSach })" class="btn w-100 mb-3 @buttonClass" style="padding: 12px 28px">
                <i class="@iconClass me-2"></i>
                @buttonText
            </a>

            <a href="@Url.Action("Index", "Product")" class="btn btn-custom w-100 mb-3">
                <i class="fa-solid fa-arrow-left"></i>
                Tiếp tục xem sách
            </a>
        </div>
    </div>

    <!-- Chi tiết -->
    <div class="row mt-5">
        <!-- Mô tả -->
        <div class="col-lg-9 col-sm-12">
            <h5>Mô tả</h5>
            <hr />
            <table class="table table-bordered text-center">
                <tbody>
                    <tr>
                        <td>Tác giả</td>
                        <td>@Model.TacGia</td>
                    </tr>
                    <tr>
                        <td>Nhà xuất bản</td>
                        <td>@Model.NXB.TenNXB</td>
                    </tr>
                    <tr>
                        <td>Năm xuất bản</td>
                        <td>@Model.NamXB</td>
                    </tr>
                    <tr>
                        <td>Số trang</td>
                        <td>@Model.SoTrang</td>
                    </tr>
                    <tr>
                        <td>Số lượng tồn</td>
                        <td>@Model.SoLuongTon</td>
                    </tr>
                    <tr>
                        <td>Lượt mua</td>
                        <td>@Model.LuotMua</td>
                    </tr>
                    <tr>
                        <td>Đánh giá</td>
                        <td>@Model.DiemDanhGia/5</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Đánh giá của khách hàng -->
        <div class="col-lg-3 col-sm-12">
            <h5>Đánh giá của khách hàng</h5>
            <hr />
            @if (Model.DanhGias != null && Model.DanhGias.Any())
            {
                foreach (var i in Model.DanhGias.OrderByDescending(d => d.NgayDanhGia))
                {
                    <div class="card card-body mb-3">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title fw-bold">@i.NguoiDung.HoTen</h6>
                                <p>@i.NgayDanhGia.Value.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div>
                                <img src="@Url.Content("~/Content/Images/"+i.NguoiDung.AnhDaiDien)" class="mx-auto rounded-4" style="height:50px;width:50px ;object-fit:cover" alt="...">
                            </div>
                        </div>
                        <p>
                            @if (i.SoSao.HasValue)
                            {
                                for (int j = 0; j < i.SoSao.Value; j++)
                                {
                                    <i class="fas fa-star text-warning"></i>
                                }
                                for (int j = i.SoSao.Value; j < 5; j++)
                                {
                                    <i class="far fa-star text-secondary"></i>
                                }
                            }
                        </p>
                        <p class="my-0">@i.BinhLuan</p>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Chưa có đánh giá nào.
                </div>
            }

            @if (Session["User"] != null)
            {
                if (hasPurchased && !hasReviewed)
                {
                    <a href="@Url.Action("AddReview", "Review", new { maSach = Model.MaSach })" class="btn btn-custom w-100 mb-3">
                        <i class="fas fa-pen me-2"></i>
                        Viết đánh giá
                    </a>
                }
                else if (hasReviewed)
                {
                    <div class="alert alert-success text-center mb-3">
                        <i class="fas fa-check-circle me-2"></i>
                        Bạn đã đánh giá sản phẩm này.
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center mb-3">
                        <i class="fas fa-info-circle me-2"></i>
                        Vui lòng mua sách để có thể đánh giá.
                    </div>
                }
            }
            else
            {
                <a href="@Url.Action("Login", "User")" class="text-dark text-decoration-none">
                    <div class="alert alert-secondary text-center mb-3">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Đăng nhập để đánh giá sản phẩm.
                    </div>
                </a>
            }
        </div>
    </div>

    <!-- Sản phẩm liên quan -->
    <div class="row my-3">
        <h3 class="fw-bold m-0" style="color:#2c3e50">Sản phẩm liên quan</h3>
        @foreach (var i in ViewBag.SanPhamLienQuan)
        {
            <div class="col-lg-3 col-md-4 col-6 product mt-2">
                <div class="card card-body border-0 rounded-4">
                    <a href="@Url.Action("Detail", "Product", new { id = i.MaSach })">
                        <img src="@Url.Content("~/Content/Images/"+i.AnhBia)" class="img-fluid mx-auto w-100" style="height: 250px; object-fit: cover" alt="...">
                    </a>
                    <div class="d-flex justify-content-between gap-3">
                        <div class="text-start flex-grow-1 overflow-hidden">
                            <p class="card-text text-danger title my-1">@i.TacGia</p>
                            <h5 class="card-title title my-2">@i.TenSach</h5>
                            <span class="card-text fw-bold text-danger">@i.GiaBan.ToString("N0", new CultureInfo("en-US")) đ</span><br />
                            <span class="card-text text-secondary text-decoration-line-through">@i.GiaGoc.ToString("N0", new CultureInfo("en-US")) đ</span>
                        </div>
                        <div class="d-flex flex-column gap-2 my-2">
                            <a href="#" class="btn btn-icon btn-sm rounded-circle p-2">
                                <i class="fas fa-heart"></i>
                            </a>
                            <a href="#" class="btn btn-icon btn-sm rounded-circle p-2">
                                <i class="fas fa-shopping-cart"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Bắt sự kiện click vào tất cả các ảnh có class là 'thumb'
        $(".img-thumbnail").on("click", function () {

            // 1. Lấy đường dẫn ảnh lớn từ thuộc tính data-full-src của ảnh nhỏ được click
            var newImageSrc = $(this).data("full-src");

            // 2. Cập nhật thuộc tính src của ảnh lớn (#mainImage)
            $("#mainImage").attr("src", newImageSrc);

            // (Tùy chọn) Thêm hiệu ứng/class active nếu cần
            $(".img-thumbnail").removeClass("active-thumb");
            $(this).addClass("active-thumb");
        });
    });
</script>
