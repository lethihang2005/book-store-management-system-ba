@model IEnumerable<DoAnLTW.NXB>

<!-- Publishers -->
<div class="mb-3">
    <h3 class="text-uppercase fw-bold">Tác giả</h3>
    <div style="max-height: 250px; overflow-y: auto;">
        @foreach (var i in Model)
        {
            <div class="py-2">
                <label class="d-flex align-items-center w-100" style="cursor: pointer; margin-bottom: 0;">
                    <input name="author" type="checkbox" id="author-@i.MaNXB" value="@i.MaNXB" style="margin-top: 2px; flex-shrink: 0;" />
                    <span class="title flex-grow-1 ms-2">@i.TenNXB</span>
                </label>
            </div>
        }
    </div>
</div>