<!-- Lọc -->
<div class="row">
    <div class="d-flex justify-content-between">
        <div class="dropdown">
            <button class="btn btn-outline-custom dropdown-toggle" type="button"
                    id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-sort me-2"></i> Sắp xếp
            </button>
            <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                <li>
                    <a class="dropdown-item @(ViewBag.CurrentSort == null || ViewBag.CurrentSort == "" ? "active" : "")"
                       href="@Url.Action("Index", "Product", new { sort = "" })">
                        Mặc định
                    </a>
                </li>

                <li>
                    <a class="dropdown-item @(ViewBag.CurrentSort == "price_asc" ? "active" : "")"
                       href="@Url.Action("Index", "Product", new { sort = "price_asc" })">
                        Giá thấp đến cao
                    </a>
                </li>

                <li>
                    <a class="dropdown-item @(ViewBag.CurrentSort == "price_desc" ? "active" : "")"
                       href="@Url.Action("Index", "Product", new { sort = "price_desc" })">
                        Giá cao đến thấp
                    </a>
                </li>

                <li>
                    <a class="dropdown-item @(ViewBag.CurrentSort == "rating_asc" ? "active" : "")"
                       href="@Url.Action("Index", "Product", new { sort = "rating_asc" })">
                        Đánh giá thấp đến cao
                    </a>
                </li>

                <li>
                    <a class="dropdown-item @(ViewBag.CurrentSort == "rating_desc" ? "active" : "")"
                       href="@Url.Action("Index", "Product", new { sort = "rating_desc" })">
                        Đánh giá cao đến thấp
                    </a>
                </li>
            </ul>
        </div>
        <div>
            <button class="btn btn-outline-custom d-md-none mb-3" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#offcanvasFilter"
                    aria-controls="offcanvasFilter">
                <i class="fas fa-filter me-2"></i> Bộ lọc
            </button>
        </div>
    </div>
</div>